# Скопируйте в .env и при необходимости поменяйте значения.
# Все переменные необязательны, кроме JWT_SECRET в режиме production.

# ── Сервер ──
# development | production | test
APP_ENV=development
HOST=0.0.0.0
PORT=3000
# Публичный адрес сайта: из него строятся ссылки на страницы оплаты (url в Checkout Session).
# На Render задавать не нужно — берётся из RENDER_EXTERNAL_URL.
PUBLIC_URL=http://localhost:3000
# critical | error | warning | info | debug | silent
LOG_LEVEL=info
# Сколько обратных прокси стоит перед приложением (Render, Caddy) — для определения IP клиента.
TRUST_PROXY=1

# ── Безопасность ──
# Секрет подписи сессий кабинета (JWT), минимум 32 символа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Сколько живёт сессия продавца: 12h, 30m, 7d
SESSION_TTL=12h

# ── База данных ──
# Пусто — данные хранятся в памяти (демо-режим, всё пропадёт при перезапуске).
# Пример локально: postgresql://postgres:postgres@localhost:5432/cryptopay
# Пример Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# auto | true | false | no-verify
#   auto — sslmode из строки подключения; если его нет: без SSL локально, с SSL для удалённой базы
#   true — SSL с проверкой сертификата
DATABASE_SSL=auto

# ── Платежи ──
# Сколько блоков имитируемой сети должно лечь поверх транзакции, чтобы платёж стал успешным.
REQUIRED_CONFIRMATIONS=3
# Комиссия платформы в базисных пунктах: 100 = 1 %.
PLATFORM_FEE_BPS=100
# Как часто «появляется» блок в имитации сети MockChain, секунды.
MOCK_BLOCK_TIME_SECONDS=3

# ── Демо-аккаунт для проверки проекта ──
# Создаётся при старте; данные входа показываются на странице входа в кабинет.
DEMO_ACCOUNT=true
DEMO_EMAIL=demo@cryptopay.dev
DEMO_PASSWORD=demo-password

# ── Фоновые задачи (сверка с кошельком, истечение страниц, вебхуки) ──
WORKER_ENABLED=true
WORKER_INTERVAL_MS=3000

# В разработке http:// и localhost для вебхуков разрешены; в production — только https и внешние адреса.
# ALLOW_HTTP_WEBHOOKS=true
