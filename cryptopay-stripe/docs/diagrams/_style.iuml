' Общий стиль всех диаграмм CryptoPay: те же «чернила» и фиолетовая печать, что и в интерфейсе.
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam dpi 120
skinparam BackgroundColor #FFFFFF
skinparam ArrowColor #1E2638
skinparam ArrowFontColor #5A6478
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.2
skinparam NoteBackgroundColor #FBF1DE
skinparam NoteBorderColor #9A6200
skinparam NoteFontSize 11
skinparam TitleFontSize 17
skinparam TitleFontStyle bold
skinparam TitleFontColor #1E2638

skinparam class {
  BackgroundColor #FBFCFE
  BorderColor #5B3CC4
  HeaderBackgroundColor #EEEAFB
  AttributeFontSize 12
  StereotypeFontColor #5A6478
}
skinparam interface {
  BackgroundColor #EEEAFB
  BorderColor #5B3CC4
}
skinparam package {
  BackgroundColor #F5F7FA
  BorderColor #8A93A3
  FontColor #1E2638
}
skinparam component {
  BackgroundColor #FBFCFE
  BorderColor #5B3CC4
}
skinparam node {
  BackgroundColor #F5F7FA
  BorderColor #1E2638
}
skinparam database {
  BackgroundColor #EEEAFB
  BorderColor #5B3CC4
}
skinparam actor {
  BackgroundColor #EEEAFB
  BorderColor #5B3CC4
}
skinparam usecase {
  BackgroundColor #FBFCFE
  BorderColor #5B3CC4
}
skinparam state {
  BackgroundColor #FBFCFE
  BorderColor #5B3CC4
  StartColor #1E2638
  EndColor #1E2638
}
skinparam activity {
  BackgroundColor #FBFCFE
  BorderColor #5B3CC4
  DiamondBackgroundColor #EEEAFB
  DiamondBorderColor #5B3CC4
}
skinparam sequence {
  LifeLineBorderColor #8A93A3
  ParticipantBackgroundColor #FBFCFE
  ParticipantBorderColor #5B3CC4
  GroupBorderColor #8A93A3
  GroupBackgroundColor #F5F7FA
  BoxBorderColor #C7D0DB
}
skinparam rectangle {
  BackgroundColor #FBFCFE
  BorderColor #5B3CC4
}
skinparam object {
  BackgroundColor #FBFCFE
  BorderColor #5B3CC4
}
skinparam legend {
  BackgroundColor #F5F7FA
  BorderColor #8A93A3
  FontSize 11
}
