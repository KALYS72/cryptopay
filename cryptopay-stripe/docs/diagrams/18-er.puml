@startuml er
!include _style.iuml
title ER-диаграмма — PostgreSQL (migrations/001_initial_schema.sql)
hide circle
skinparam linetype ortho

entity merchants {
  * id : text <<PK>>
  --
  * email : text <<UNIQUE>>
  * business_name : text
  * password_hash : text  «scrypt»
  api_key_hash : text <<UNIQUE>>
  api_key_last4 : text
  * created_at : timestamptz
}

entity payment_intents {
  * id : text <<PK>>
  --
  * merchant_id : text <<FK>>
  * amount : numeric(78,0)  CHECK > 0
  * currency : text
  * status : text  CHECK IN (…5)
  metadata : jsonb
  checkout_session_id : text
  wallet_request_id : text
  wallet_tx_id : text <<UNIQUE>>
  payer_address : text
  confirmations, required_confirmations : int
  amount_received, amount_refunded : numeric
  last_error_code, last_error_message : text
  * version : int  «оптимистическая блокировка»
  CHECK amount_refunded <= amount_received
}

entity checkout_sessions {
  * id : text <<PK>>
  --
  * merchant_id : text <<FK>>
  * payment_intent_id : text <<FK, UNIQUE>>
  * status : open | complete | expired
  * payment_status : unpaid | paid
  success_url, cancel_url : text
  * expires_at : timestamptz
}

entity refunds {
  * id : text <<PK>>
  --
  * merchant_id : text <<FK>>
  * payment_intent_id : text <<FK>>
  * amount : numeric(78,0)
  * status : pending | succeeded | failed
  * destination_address : text
  wallet_tx_id : text <<UNIQUE>>
}

entity balance_transactions {
  * id : text <<PK>>
  --
  * merchant_id : text <<FK>>
  * type : payment | refund | refund_failure
  * source_id : text  «pi_… / re_…»
  * amount, fee, net : numeric(78,0)
  CHECK net = amount − fee
  UNIQUE (source_id) WHERE type = 'payment'
}

entity events {
  * id : text <<PK>>
  --
  * merchant_id : text <<FK>>
  * type : text
  * subject_id : text
  * data : jsonb  «data.object»
  * created_at : timestamptz
}

entity webhook_endpoints {
  * id : text <<PK>>
  --
  * merchant_id : text <<FK>>
  * url : text
  * secret : text  «whsec_…»
  * enabled_events : text[]
}

entity webhook_deliveries {
  * id : text <<PK>>
  --
  * event_id : text <<FK>>
  * endpoint_id : text
  * status : pending | delivered | failed
  * attempts : int
  * next_attempt_at : timestamptz
}

entity idempotency_keys {
  * merchant_id : text <<PK, FK>>
  * key : text <<PK>>
  --
  * request_hash : text
  * status : processing | completed
  response_status : int
  response_body : text
}

merchants ||--o{ payment_intents
merchants ||--o{ checkout_sessions
payment_intents ||--|| checkout_sessions
payment_intents ||--o{ refunds
merchants ||--o{ balance_transactions
merchants ||--o{ events
merchants ||--o{ webhook_endpoints
events ||--o{ webhook_deliveries
merchants ||--o{ idempotency_keys
@enduml
