@startuml class-persistence
!include _style.iuml
title Диаграмма классов — хранение (Repository, Unit of Work, LSP)
hide empty members

abstract class UnitOfWork <<port>> {
  + repos: Repositories
  + transaction(): AsyncContextManager[Repositories]
}
class Repositories <<record>> {
  + merchants
  + payment_intents
  + checkout_sessions
  + refunds
  + ledger
  + events
  + webhook_endpoints
  + outbox
  + idempotency
}
abstract class PaymentIntentRepository <<port>> {
  + insert(intent)
  + update(intent)  «версия!»
  + find_by_id(id)
  + page(merchant, ListQuery, status): Page
  + list_waiting_for_wallet(limit)
}
abstract class LedgerRepository <<port>> {
  + append(entry)
  + balances(merchant): dict
  + daily_volume(merchant, since)
}
abstract class IdempotencyStore <<port>> {
  + try_begin(record)
  + complete(...) / release(...)
}

class InMemoryUnitOfWork {
  - _lock: asyncio.Lock
  + transaction(): снимок → откат при ошибке
}
class PostgresUnitOfWork {
  - _pool: AsyncConnectionPool
  + transaction(): BEGIN … COMMIT / ROLLBACK
}
class InMemoryPaymentIntentRepository
class PgPaymentIntentRepository {
  UPDATE … WHERE id = %s AND version = %s
}
class RepositoryContract <<тесты>> {
  16 общих проверок
}

UnitOfWork --> Repositories
Repositories o-- PaymentIntentRepository
Repositories o-- LedgerRepository
Repositories o-- IdempotencyStore
InMemoryUnitOfWork -up-|> UnitOfWork
PostgresUnitOfWork -up-|> UnitOfWork
InMemoryPaymentIntentRepository -up-|> PaymentIntentRepository
PgPaymentIntentRepository -up-|> PaymentIntentRepository
RepositoryContract ..> InMemoryUnitOfWork : TestInMemoryRepositories
RepositoryContract ..> PostgresUnitOfWork : TestPostgresRepositories

note bottom of RepositoryContract
  SOLID (L): обе реализации проходят один и тот же
  набор контрактных тестов — значит, взаимозаменяемы.
end note
@enduml
