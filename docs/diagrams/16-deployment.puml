@startuml deployment
!include _style.iuml
title Диаграмма развёртывания — облако Render + Neon

node "Браузер покупателя" as Browser {
  artifact "checkout.html\nwallet-approve.html" as PagesC
}
node "Браузер продавца" as Browser2 {
  artifact "dashboard.html" as PagesM
}
node "Сервер магазина\n(любой хостинг)" as ShopNode {
  artifact "examples/shop.py\nили свой бэкенд" as ShopApp
}

cloud "Render (Frankfurt), план Free" {
  node "Web Service\nDocker-контейнер python:3.13-slim\nпользователь app (не root)" as Web {
    component "uvicorn + FastAPI" as App
    component "Scheduler (asyncio)" as Sched
    component "MockWallet + MockChain\n(в памяти процесса)" as Mock
    artifact "migrations/*.sql" as Mig
    artifact "public/ (статика)" as Static
  }
  node "Прокси Render\n(TLS, HTTPS-сертификат)" as Proxy
}
cloud "Neon, план Free" {
  database "PostgreSQL 16\n(9 таблиц)" as DB
}
node "GitHub" {
  artifact "репозиторий +\nGitHub Actions CI" as Repo
}

Browser --> Proxy : HTTPS 443
Browser2 --> Proxy : HTTPS 443
ShopApp --> Proxy : HTTPS: /v1 + sk_test_…
Proxy --> App : HTTP :3000\nX-Forwarded-For
App --> DB : TLS 5432 (sslmode=require),\npsycopg 3, пул соединений
App --> ShopApp : вебхуки HTTPS POST\nCryptoPay-Signature
App - Mock
App - Sched
Repo --> Web : push → сборка образа\nпо render.yaml (Blueprint)

note bottom of Mock
  Имитация кошелька живёт в памяти:
  после перезапуска тестовые балансы
  возвращаются к исходным, а платежи
  и журнал остаются в PostgreSQL.
end note
@enduml
