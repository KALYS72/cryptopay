@startuml timing
!include _style.iuml
title Временная диаграмма — платёж Алисы при блоке раз в 3 секунды

concise "MockChain (высота)" as H
robust "PaymentIntent" as PI
robust "CheckoutSession" as CS
concise "Страница оплаты" as P

@0
H is "100"
PI is requires_payment_method
CS is open
P is "форма"

@4
PI is requires_action
P is "кошелёк"

@9
H is "103"
PI is processing
P is "0 из 3"

@12
H is "104"
P is "1 из 3"

@15
H is "105"
P is "2 из 3"

@18
H is "106"
PI is succeeded
CS is complete
P is "ОПЛАЧЕНО"

@23
P is "success_url"

@0 <-> @18 : ≈ 18 с от нажатия «Оплатить» до «Оплачено»
@enduml
